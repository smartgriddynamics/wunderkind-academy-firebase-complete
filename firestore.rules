rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /applicantAccounts/{uid} {
      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['uid','email','role','createdAt']) &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'user' &&
        request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update, delete: if false;
    }
    match /applications/{id} {
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          'id','ownerUid','accountEmail','submittedAt','status','studentName','formDate','nickname',
          'dateOfBirth','gender','nationality','birthPlace','address','staysWith','birthCertificateAttached',
          'passportDocument','birthCertificateDocument','birthCertificateFrontDocument','birthCertificateBackDocument',
          'previousSchool','religion','allergies','congenitalIllness','otherChildInformation','applyingFor',
          'mother','father','otherContact','guardianName','guardianRelationship','guardianPhone','guardianEmail'
        ]) &&
        request.resource.data.keys().hasAll([
          'id','ownerUid','accountEmail','submittedAt','status','studentName','formDate','nickname',
          'dateOfBirth','gender','nationality','birthPlace','address','staysWith','birthCertificateAttached',
          'passportDocument','birthCertificateDocument','birthCertificateFrontDocument','birthCertificateBackDocument',
          'previousSchool','religion','allergies','congenitalIllness','otherChildInformation','applyingFor',
          'mother','father','otherContact','guardianName','guardianRelationship','guardianPhone','guardianEmail'
        ]) &&
        request.resource.data.id == id &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.accountEmail == request.auth.token.email &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.studentName is string &&
        request.resource.data.studentName.size() > 0 &&
        request.resource.data.studentName.size() <= 150 &&
        request.resource.data.guardianName is string &&
        request.resource.data.guardianEmail is string &&
        request.resource.data.guardianPhone is string &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.passportDocument is string &&
        request.resource.data.passportDocument == 'applicationDocuments/' + request.auth.uid + '/' + id + '/passport' &&
        request.resource.data.birthCertificateDocument is string &&
        request.resource.data.birthCertificateDocument == '' &&
        request.resource.data.birthCertificateFrontDocument is string &&
        request.resource.data.birthCertificateFrontDocument == 'applicationDocuments/' + request.auth.uid + '/' + id + '/birth-certificate-front' &&
        request.resource.data.birthCertificateBackDocument is string &&
        request.resource.data.birthCertificateBackDocument == 'applicationDocuments/' + request.auth.uid + '/' + id + '/birth-certificate-back' &&
        request.resource.data.mother is map &&
        request.resource.data.mother.keys().hasOnly(['name','phone','work','nida','passportPhoto']) &&
        request.resource.data.mother.passportPhoto == 'applicationDocuments/' + request.auth.uid + '/' + id + '/mother-passport' &&
        request.resource.data.father is map &&
        request.resource.data.father.keys().hasOnly(['name','phone','work','nida','passportPhoto']) &&
        request.resource.data.father.passportPhoto == 'applicationDocuments/' + request.auth.uid + '/' + id + '/father-passport' &&
        request.resource.data.otherContact is map &&
        request.resource.data.otherContact.keys().hasOnly(['name','phone','address','nida']);
      allow read: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /messages/{id} {
      allow create: if request.auth == null &&
        request.resource.data.keys().hasOnly(['name','email','subject','message','createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 150 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.subject is string && request.resource.data.subject.size() <= 200 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000 &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /{kind}/{id} {
      allow read: if kind in ['news','events'] && (resource.data.published == true || isAdmin());
      allow create, update, delete: if kind in ['news','events'] && isAdmin();
    }
  }
}
